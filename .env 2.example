# Art Explorer Environment Configuration
# Copy this file to .env and fill in your Railway PostgreSQL credentials

# Development mode (set to false to use PostgreSQL instead of SQLite)
DEVELOPMENT_MODE=false

# Railway PostgreSQL Database URL
# Get this from your Railway project dashboard -> PostgreSQL service -> Connect tab
# Format: postgresql://postgres:password@hostname:port/database
DATABASE_URL=

# Alternative: Individual PostgreSQL connection parameters
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=railway

# Railway automatically sets these variables in production
RAILWAY_ENVIRONMENT=production

# Optional: Redis URL for image caching
REDIS_URL=

# Application Configuration
API_SECRET_KEY=your-secret-key-here
